# Copy to .env and adjust as needed.
# Local Docker Postgres (docker-compose.yml) — the default:
DATABASE_URL=postgres://umbra:umbra@localhost:5432/umbra
# Or a hosted Postgres (Neon / Supabase / RDS). SSL turns on automatically
# when the URL includes ?sslmode=require, or set PGSSL=true:
#   DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
PORT=3000

# Auth: "dev" (default) enables email-only dev login for local use.
# Set to "workos" plus the WorkOS env vars for production SSO.
AUTH_MODE=dev
# NODE_ENV=production   # in prod, makes the session cookie Secure

# Public base URL of this backend — handed to collectors as their apiBase
# and shown in the console's deployment guide.
PUBLIC_API_BASE=http://localhost:3000
# Published Chrome Web Store ID of the collector extension.
# Stays a placeholder until the collector is published.
COLLECTOR_EXTENSION_ID=REPLACE_WITH_PUBLISHED_COLLECTOR_EXTENSION_ID

# --- WorkOS SSO (production auth) ---
# Switch AUTH_MODE above to "workos", then fill these in. With workos mode on,
# the email-only dev login is disabled. Register WORKOS_REDIRECT_URI in the
# WorkOS Dashboard -> Redirects.
# WORKOS_API_KEY=sk_test_xxxxxxxx
# WORKOS_CLIENT_ID=client_xxxxxxxx
# WORKOS_REDIRECT_URI=http://localhost:3000/auth/workos/callback
